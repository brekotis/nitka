[Unit]
Description=Nitka — карты и профили походов (турклуб «Восхождение»)
After=network-online.target
Wants=network-online.target

[Service]
User=nitka
Group=nitka
WorkingDirectory=/opt/nitka
Environment=NITKA_DATA=/var/lib/nitka NITKA_PORT=8080 NITKA_HOST=127.0.0.1 PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/nitka.env
ExecStart=/opt/nitka/.venv/bin/python -m server.app
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nitka
MemoryMax=1400M
Nice=5

[Install]
WantedBy=multi-user.target
